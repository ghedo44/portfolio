---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import "katex/dist/katex.min.css";
import BaseLayout from "./BaseLayout.astro";
import BlogSearch from "../components/BlogSearch.astro";
import Comments from "../components/Comments.astro";
import FormattedDate from "../components/FormattedDate.astro";
import HeaderLink from "../components/HeaderLink.astro";
import PagefindAssets from "../components/PagefindAssets.astro";

type Props = CollectionEntry<"blog">;

const { id, data } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags,
} = data;
const pageTitle = `${title}`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  image={heroImage || undefined}
  pageType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  pagefind={true}
>
  <PagefindAssets slot="head" />

  <div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <BlogSearch compact={true} />

    <div class="mb-8">
      <HeaderLink href="/blog/" data-return-link>
        &larr; All posts
      </HeaderLink>
    </div>
    <article>
      <header class="mb-8">
        {
          heroImage && (
            <div
              class="mb-8 rounded-lg overflow-hidden"
              transition:name={`post-image-${id}`}
            >
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt={heroImageAlt || ""}
                class="w-full"
              />
            </div>
          )
        }
        <div class="text-gray-500 text-sm mb-4">
          <span transition:name={`post-date-${id}`}>
            <FormattedDate date={pubDate} />
          </span>
          {
            updatedDate && (
              <span class="italic ml-2">
                — Updated{" "}
                <span transition:name={`post-updated-${id}`}>
                  <FormattedDate date={updatedDate} />
                </span>
              </span>
            )
          }
        </div>
        <h1 class="text-4xl font-bold mb-4">
          <span transition:name={`post-title-${id}`}>{title}</span>
        </h1>
        {
          tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {tags.map((tag) => (
                <span
                  class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full"
                  transition:name={`post-tag-${id}-${tag}`}
                  data-pagefind-filter="tag"
                >
                  {tag}
                </span>
              ))}
            </div>
          )
        }
        <hr class="my-6" />
      </header>

      <div class="prose prose-neutral max-w-none">
        <slot />
      </div>
    </article>
    <div class="mt-12">
      <HeaderLink href="/blog/" data-return-link>
        &larr; All posts
      </HeaderLink>
    </div>
    <Comments />
  </div>

  <script is:inline>
    const updateReturnLinks = () => {
      const from = new URL(window.location.href).searchParams.has("from");

      document.querySelectorAll("[data-return-link]").forEach((link) => {
        link.onclick = from
          ? (event) => {
              event.preventDefault();
              window.history.back();
            }
          : null;
      });
    };

    updateReturnLinks();
    document.addEventListener("astro:page-load", updateReturnLinks);
  </script>
</BaseLayout>
