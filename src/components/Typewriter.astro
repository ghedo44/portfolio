---
interface Props {
  words: string[];
  typingSpeed?: number;
  deletingSpeed?: number;
  pauseTime?: number;
}

const {
  words,
  typingSpeed = 80,
  deletingSpeed = 45,
  pauseTime = 1600,
} = Astro.props;
---

<type-writer
  class="typewriter"
  data-words={JSON.stringify(words)}
  data-typing-speed={typingSpeed}
  data-deleting-speed={deletingSpeed}
  data-pause-time={pauseTime}
  role="text"
  aria-label={words.join(", ")}
>
  <span class="sr-only">{words.join(", ")}</span>
  <span class="typewriter__text" aria-hidden="true">{words[0]}</span>
  <span class="typewriter__cursor" aria-hidden="true"></span>
</type-writer>

<script>
  class TypeWriter extends HTMLElement {
    private timeoutId?: number;

    connectedCallback() {
      this.stop();

      const textElement = this.querySelector<HTMLElement>(
        ".typewriter__text"
      );

      if (!textElement) return;

      let words: string[];

      try {
        words = JSON.parse(this.dataset.words ?? "[]");
      } catch {
        words = [];
      }

      if (!words.length) return;

      const typingSpeed = Number(this.dataset.typingSpeed ?? 80);
      const deletingSpeed = Number(this.dataset.deletingSpeed ?? 45);
      const pauseTime = Number(this.dataset.pauseTime ?? 1600);

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (reduceMotion) {
        textElement.textContent = words[0];
        return;
      }

      let wordIndex = 0;
      let characterIndex = 0;
      let deleting = false;

      textElement.textContent = "";

      const animate = () => {
        if (!this.isConnected) return;

        const currentWord = words[wordIndex];

        characterIndex += deleting ? -1 : 1;
        textElement.textContent = currentWord.slice(0, characterIndex);

        let delay = deleting ? deletingSpeed : typingSpeed;

        if (!deleting && characterIndex === currentWord.length) {
          deleting = true;
          delay = pauseTime;
        } else if (deleting && characterIndex === 0) {
          deleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          delay = 350;
        }

        this.timeoutId = window.setTimeout(animate, delay);
      };

      animate();
    }

    disconnectedCallback() {
      this.stop();
    }

    private stop() {
      if (this.timeoutId !== undefined) {
        window.clearTimeout(this.timeoutId);
        this.timeoutId = undefined;
      }
    }
  }

  if (!customElements.get("type-writer")) {
    customElements.define("type-writer", TypeWriter);
  }
</script>

<style>
  .typewriter {
    display: inline-flex;
    align-items: baseline;
    min-height: 1em;
  }

  .typewriter__cursor {
    width: 0.08em;
    height: 0.9em;
    margin-left: 0.12em;
    background: currentColor;
    animation: blink 0.8s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter__cursor {
      animation: none;
    }
  }
</style>