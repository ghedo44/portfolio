---
import { NAVIGATION, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const titleText = `«${SITE_TITLE}»`;
const navItems = NAVIGATION.filter((item) => item.href !== "/");
---

<header class="relative isolate" transition:persist>
  <div
    class="pointer-events-none absolute inset-0 bg-white/40 backdrop-blur-2xl
    mask-[linear-gradient(to_bottom,black_0%,transparent_70%)]
    [-webkit-mask-image:linear-gradient(to_bottom,black_0%,transparent_70%)]"
  >
  </div>
  <nav
    class="relative flex justify-between items-center p-4 max-w-3xl mx-auto z-10"
    aria-label="Primary navigation"
  >
    <a
      href="/"
      class="site-title text-black! text-4xl font-bold no-underline"
      aria-label={titleText}
    >
      <span class="site-title__text" data-text={titleText}>
        {titleText.slice(0, -1)}<span class="site-title__char">
          {titleText.slice(-1)}
          <span class="site-title__cursor-bg" aria-hidden="true"></span>
          <span class="site-title__cursor-char" aria-hidden="true">{titleText.slice(-1)}</span>
        </span>
      </span>
    </a>
    <div class="nav-array">
      <span class="nav-array__bracket" aria-hidden="true">[</span>
      {
        navItems.map((item, i) => (
          <>
            <span class="nav-array__quote" aria-hidden="true">"</span>
            <HeaderLink href={item.href}>{item.label.toLowerCase()}</HeaderLink>
            <span class="nav-array__quote" aria-hidden="true">"</span>
            {i < navItems.length - 1 && (
              <span class="nav-array__comma" aria-hidden="true">, </span>
            )}
          </>
        ))
      }
      <span class="nav-array__bracket" aria-hidden="true">]</span>
    </div>
  </nav>
</header>

<style>
  .site-title {
    display: inline-block;
    position: relative;
    text-decoration: none;
  }

  .site-title__text {
    position: relative;
    display: inline-block;
    transition:
      transform 160ms ease,
      text-shadow 160ms ease,
      color 160ms ease;
  }

  .site-title__text::before,
  .site-title__text::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .site-title__text::before {
    color: #000;
    transform: translate(0, 0);
  }

  .site-title__text::after {
    color: #000;
    -webkit-text-stroke: 1px #000;
    text-shadow: 0 0 0 #000;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-title:hover .site-title__text,
    .site-title:focus-visible .site-title__text {
      animation: site-title-glitch 220ms steps(2, end) 1 both;
      font-weight: 600;
      text-shadow:
        0.04em 0 0 #000,
        -0.04em 0 0 #000;
    }

    .site-title:hover .site-title__text::before,
    .site-title:hover .site-title__text::after,
    .site-title:focus-visible .site-title__text::before,
    .site-title:focus-visible .site-title__text::after {
      opacity: 0.5;
    }

    .site-title:hover .site-title__text::before,
    .site-title:focus-visible .site-title__text::before {
      animation: site-title-glitch-before 220ms steps(2, end) 1 both;
    }

    .site-title:hover .site-title__text::after,
    .site-title:focus-visible .site-title__text::after {
      animation: site-title-glitch-after 220ms steps(2, end) 1 both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-title:hover .site-title__text,
    .site-title:focus-visible .site-title__text {
      font-weight: 600;
    }
  }

  @keyframes site-title-glitch {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-1px, 0);
    }
    50% {
      transform: translate(1px, 0);
    }
    75% {
      transform: translate(0, -1px);
    }
  }

  @keyframes site-title-glitch-before {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-1px, 0);
    }
  }

  @keyframes site-title-glitch-after {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(1px, 0);
    }
  }

  /* Vim visual-mode cursor — black block inverts to white char */
  .site-title__char {
    position: relative;
    display: inline-block;
    line-height: 1;
  }

  .site-title__cursor-bg {
    position: absolute;
    inset: 0;
    background: #000;
    animation: cursor-blink 1s step-end infinite;
    pointer-events: none;
  }

  .site-title__cursor-char {
    position: absolute;
    inset: 0;
    color: #fff;
    animation: cursor-blink 1s step-end infinite;
    pointer-events: none;
  }

  @keyframes cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-title__cursor {
      animation: none;
      opacity: 1;
    }
  }

  /* Nav array styling */
  .nav-array {
    display: flex;
    align-items: center;
    gap: 0;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
      "Liberation Mono", monospace;
    font-size: 0.95rem;
    color: #666;
  }

  .nav-array__bracket,
  .nav-array__quote,
  .nav-array__comma {
    color: #999;
    user-select: none;
    pointer-events: none;
  }

  .nav-array :global(a) {
    color: inherit;
    text-decoration: none;
    font-family: inherit;
    font-size: inherit;
    transition: color 160ms ease;
  }

  .nav-array :global(a):hover {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nav-array :global(a[aria-current="page"]) {
    color: #000;
    font-weight: 600;
  }
</style>
