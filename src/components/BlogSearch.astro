---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
  class:list={[
    "blog-search border border-gray-200 rounded-lg bg-white/70 backdrop-blur-sm p-4",
    compact ? "mb-8" : "mb-10",
  ]}
  aria-label="Search blog posts"
  data-pagefind-ignore="all"
>
  <pagefind-config instance="blog" bundle-path="/pagefind/" faceted></pagefind-config>

  <div class="blog-search__controls">
    <pagefind-input instance="blog" placeholder="Search blog posts..."></pagefind-input>
    <pagefind-filter-dropdown
      instance="blog"
      filter="tag"
      label="Tags"
      single-select
      sort="alphabetical"
    ></pagefind-filter-dropdown>
  </div>

  <div class="blog-search__results">
    <pagefind-summary instance="blog"></pagefind-summary>
    <pagefind-results
      instance="blog"
      hide-sub-results
      max-results={compact ? 5 : 20}
    ></pagefind-results>
  </div>

  <p class="text-sm text-gray-500 mt-3" data-pagefind-status role="status">
    Search is available after a production build.
  </p>
</section>

<script is:inline data-astro-rerun>
  document.querySelectorAll("[data-pagefind-status]").forEach((status) => {
    if ("customElements" in window) {
      customElements.whenDefined("pagefind-input").then(() => status.remove());
    }
  });
</script>

<style>
  .blog-search {
    --pf-primary: #111827;
    --pf-text: #374151;
    --pf-muted: #6b7280;
    --pf-border: #e5e7eb;
    --pf-background: #ffffff;
  }

  .blog-search__controls {
    display: grid;
    gap: 0.75rem;
  }

  .blog-search__results {
    margin-top: 0.75rem;
  }

  pagefind-input,
  pagefind-filter-dropdown,
  pagefind-summary,
  pagefind-results {
    display: block;
  }

  @media (min-width: 640px) {
    .blog-search__controls {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }
</style>
