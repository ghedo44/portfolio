---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const hrefStr = typeof href === "string" ? href : (href?.pathname || "/");

const currentPath = Astro.url.pathname.replace(/\/+$/, "");
// Normalize: remove BASE_URL prefix, then strip trailing slash
const base = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "");
const relativePath = currentPath.startsWith(base)
  ? currentPath.slice(base.length) || "/"
  : currentPath || "/";

const normalizedHref = hrefStr.replace(/\/+$/, "") || "/";

// Active: exact match, or for nested pages match parent path
const isActive =
  relativePath === normalizedHref ||
  (normalizedHref !== "/" && relativePath.startsWith(normalizedHref));
---

<a
  href={href}
  class:list={[
    className,
    "hover:underline underline-offset-2 transition-colors",
    {
      "font-semibold text-black": isActive,
      "text-gray-600": !isActive,
    },
  ]}
  aria-current={isActive ? "page" : undefined}
  {...props}
>
  <slot />
</a>
