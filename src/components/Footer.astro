---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="relative isolate mt-12 py-8" transition:persist>
  <div
    class="pointer-events-none absolute inset-0 bg-white/40 backdrop-blur-2xl
    mask-[linear-gradient(to_bottom,transparent_0%,black_70%)]
    [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_70%)]"
  >
  </div>
  <div class="relative max-w-3xl mx-auto px-4 z-10">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-gray-600 text-sm">
        Designed and built with Astro and Tailwind CSS.
      </p>
      <SocialLinks />
    </div>
  </div>
</footer>
