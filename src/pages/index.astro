---
import "../styles/global.css";
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white text-gray-900">
		<Header />
		<main class="max-w-2xl mx-auto px-4 py-12 sm:py-16">
			<h1 class="text-4xl font-bold mb-2">Hello!</h1>
			<p class="text-xl text-gray-600 mb-8">Aerospace Engineer | Master's Student at Politecnico di Milano</p>
			<div class="prose prose-sm max-w-none space-y-4 text-base leading-relaxed">
				<p>
					Welcome to my portfolio. I graduated with a degree in <strong>Aerospace Engineering</strong> in March 2026 and am now pursuing a Master's in <strong>Space Engineering</strong> at Politecnico di Milano.
				</p>
				<p>
					Passionate about space technologies, spacecraft design, and advancing humanity's presence in space. This site showcases my projects, research, and insights from my journey in aerospace engineering.
				</p>
				<p>
					Outside of engineering, I like staying active and I play hockey, so sports and teamwork are a big part of how I spend my time.
				</p>
				<h2 class="text-2xl font-bold mt-8 mb-4">Let's connect</h2>
				<p>
					Feel free to explore my <a href="/blog" class="font-semibold text-gray-900 hover:underline">blog</a> for articles and updates, or connect with me directly here:
				</p>
				<ul class="space-y-2 list-disc">
					<li>
						<a href="/blog" class="font-semibold text-gray-900 hover:underline">Read the blog</a>
						for project notes, updates, and a few thoughts along the way.
					</li>
					<li>
						<a href="https://instagram.com/ghedo44" target="_blank" rel="noreferrer" class="font-semibold text-gray-900 hover:underline">Instagram</a>
						for a more personal look at what I am up to.
					</li>
					<li>
						<a href="https://linkedin.com/in/federico-ghedini" target="_blank" rel="noreferrer" class="font-semibold text-gray-900 hover:underline">LinkedIn</a>
						for professional updates and experience.
					</li>
					<li>
						<a href="https://github.com/ghedo44" target="_blank" rel="noreferrer" class="font-semibold text-gray-900 hover:underline">GitHub</a>
						for code and technical projects.
					</li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
