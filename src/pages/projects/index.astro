---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { getPublishedProjects } from "../../utils/projects";

const pageTitle = "Projects";
const projects = await getPublishedProjects();
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION}>
  <div class="max-w-xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-bold mb-8">Projects</h1>
    {
      projects.length === 0 ? (
        <p class="text-gray-500">No projects yet. Check back soon.</p>
      ) : (
        <div class="grid gap-6">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
